# Copy to .env
SEARXNG_URL=http://localhost:8888
# Fallback public instances (used only if bundled SearXNG is down)
SEARXNG_FALLBACKS=https://searx.be,https://search.bus-hit.me
REDIS_URL=
DATABASE_URL=
# No server-side LLM key required — BYOK. Optional defaults:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
PORT=8000
CORS_ORIGINS=http://localhost:3000
IMAGE_PROXY_ALLOWLIST=*
